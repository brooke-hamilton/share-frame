<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Template: build.rs injects the package version from Cargo.toml into the
       assemblyIdentity version below before compiling this manifest. -->
  <assemblyIdentity
      type="win32"
      name="share-frame"
      version="0.1.0.0"
      processorArchitecture="*"
  />
  <description>Share Frame</description>

  <!-- Required so TaskDialogIndirect / themed common controls resolve to
       comctl32.dll v6. Without this the v5 stub is loaded, which doesn't
       export TaskDialogIndirect and the process fails to start with
       STATUS_ENTRYPOINT_NOT_FOUND (0xC0000139). -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"
      />
    </dependentAssembly>
  </dependency>

  <!-- Tell the loader the app is DPI-aware. Code already calls
       SetProcessDpiAwarenessContext at startup; declaring it here too
       avoids a brief moment of system-DPI scaling during process init. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <!-- Declare compatibility with Windows 10 / 11 so version-detection
       APIs return the real OS version. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
